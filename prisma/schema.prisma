// Prisma Schema for Admissions Platform
// PostgreSQL database with Neon compatibility

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model (Admin, Counselor, Management) - scoped to institution when institutionId is set
model User {
  id               String            @id @default(cuid())
  username         String            @unique
  email            String            @unique
  password         String
  role             UserRole          @default(COUNSELOR)
  isActive         Boolean           @default(true)
  institutionId    String?           // Institution scope - null = legacy/global
  counselorProfile CounselorProfile?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  institution     Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  activityLogs    ActivityLog[]
  trainingContent TrainingContent[]
  trainingModules TrainingModule[]
  todos           Todo[]
  questions       Question[]
  scores          Score[]
  historicalFilesUploaded HistoricalFile[]
  historicalUploadsUploaded HistoricalUpload[] @relation("HistoricalUploadsUploaded")
  historicalUploadsVerified HistoricalUpload[]  @relation("HistoricalUploadsVerified")

  @@index([role])
  @@index([isActive])
  @@index([institutionId])
  @@map("users")
}

enum UserRole {
  ADMIN
  COUNSELOR
  MANAGEMENT
}

// Counselor Profile Model
model CounselorProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  fullName     String
  mobile       String
  expertise    String[]
  languages    String[]
  availability Availability @default(ACTIVE)
  maxCapacity  Int          @default(50)
  currentLoad  Int          @default(0)
  schoolId        String?   // Link to assigned school
  customData      Json?     // Admin-defined custom fields (e.g. hobby, interests)
  staticMeetLink  String?   // Counselor's reusable Google Meet link (no Google API)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School?             @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  assignedLeads Lead[]
  sessions      CounselingSession[]
  presence      CounselorPresence?
  trainingProgress TrainingProgress[]
  trainingAssignments TrainingModuleAssignment[]
  responses     Response[]
  callLogs      CallLog[]
  leadCalls     LeadCall[]
  parentFeedback ParentFeedback[]

  @@index([availability])
  @@index([currentLoad])
  @@index([expertise])
  @@index([languages])
  @@index([schoolId])
  @@map("counselor_profiles")
}

enum Availability {
  ACTIVE
  INACTIVE
  AWAY
  OFFLINE
}

// Lead assignment configuration modes (language, round robin, skill, performance)
enum LeadAssignmentMode {
  language
  round_robin
  skill
  performance
}

// Institution Model — run add_institution_school_and_course_fields.sql first so boards/grades persist
model Institution {
  id                   String           @id @default(cuid())
  jitofyInstitutionId   String?          @unique // External ID from Jitofy platform - links to hosting ecosystem
  name                 String           @unique
  type                 InstitutionType
  address            String?
  city               String?
  state              String?
  isActive           Boolean          @default(true)
  boardsOffered      String[]         @default([])
  standardsAvailable String[]         @default([])
  streamsOffered     String[]         @default([])
  admissionsOpen     Boolean?
  admissionsOpenByStandard Json?      // For schools: {"1-5":true,"6-10":true,"11-12":false} — which grade ranges open (derived)
  admissionsOpenGrades Json?          // For schools: [1,2,6,7] — which specific grades (1–12) have admissions open
  admissionsOpenStreams Json?         // For schools: ["Science","Commerce"] — which streams (11–12) have admissions open
  boardsByStandard   Json?            // e.g. {"1-5":["CBSE"],"6-10":["CBSE","State Board"],"11-12":["CBSE"]}
  boardGradeMap      Json?            // e.g. {"CBSE":{"primary":[1,2,3],"middle":[6,7],"high":[9,10]}}
  logoUrl            String?          // Logo image URL for school/college
  customData         Json?            // Admin-defined custom fields
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  courses       Course[]
  leads         Lead[]
  trainingModules TrainingModule[]
  historicalFiles HistoricalFile[]
  historicalAdmissions HistoricalAdmission[]
  historicalMarketingRecords HistoricalMarketingRecord[]
  parentFeedback  ParentFeedback[]
  historicalUploads HistoricalUpload[]
  users         User[]
  superAdmins  SuperAdmin[]

  @@index([jitofyInstitutionId])
  @@map("institutions")
}

// Super Admin Model - institution-level (Platform institution has jitofyInstitutionId='PLATFORM')
model SuperAdmin {
  id            String   @id @default(cuid())
  institutionId String
  email         String
  passwordHash  String
  fullName      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, email])
  @@index([institutionId])
  @@index([email])
  @@map("super_admins")
}

// School Model (Extended from Institution concept)
model School {
  id            String        @id @default(cuid())
  name          String        @unique
  board         SchoolBoard
  city          String
  state         String
  academicYear  String
  contactEmail  String?
  contactPhone  String?
  address       String?
  capacity      Int?         // School capacity
  isActive      Boolean      @default(true)
  customData    Json?        // Admin-defined custom fields
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  pockets         SchoolPocket[]
  counselors      CounselorProfile[]
  trainingModules TrainingModule[]

  @@index([board])
  @@index([city, state])
  @@index([isActive])
  @@map("schools")
}

enum SchoolBoard {
  CBSE
  ICSE
  STATE
  IGCSE
}

// School Pocket Model (Departments/Programs)
model SchoolPocket {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_pockets")
}

enum InstitutionType {
  School
  College
}

// Course Model (add board, standardRange, stream, seats, admissionsOpen after running migration)
model Course {
  id            String   @id @default(cuid())
  name          String
  code          String?  @unique
  degree        String?  // e.g., B.E, B.Tech, B.Sc, MBA
  description   String?
  institutionId String
  duration      String?
  eligibility   String?
  isActive      Boolean  @default(true)
  admissionsOpen Boolean? // For colleges: whether admissions are open for this course
  customData    Json?    // Admin-defined custom fields
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  institution          Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  leads                Lead[]
  trainingModules      TrainingModule[]
  historicalAdmissions HistoricalAdmission[]

  @@index([institutionId])
  @@map("courses")
}

// Lead Model (Parent Submission)
model Lead {
  id                      String         @id @default(cuid())
  leadId                  String?        @unique
  // Parent Details
  parentName              String
  parentMobile            String
  parentEmail             String
  parentCity              String
  preferredLanguage       String
  // Student Details
  studentName             String
  dateOfBirth             DateTime
  gender                  Gender
  currentClass            String
  boardUniversity         String?
  marksPercentage         Float?
  // Admission Preferences
  institutionId           String
  courseId                String?        // Optional: null when course not found (CRM-style import)
  importedCourseName      String?        // Excel course name when not in system; show as "CSE (course not available)"
  academicYear            String
  preferredCounselingMode CounselingMode?  // Optional: null when blank
  // Other
  notes                   String?
  consent                 Boolean        @default(false)
  customData              Json?          // Admin-defined custom fields from admission form
  // Assignment & Classification
  classification          Classification @default(NEW)
  priority                Priority       @default(NORMAL)
  assignedCounselorId     String?
  autoAssigned            Boolean        @default(false)
  assignmentReason        String         @default("")
  status                  LeadStatus     @default(NEW)
  leadSource              String?        // e.g. "College Website" (legacy)
  sourceCollege           String?        // College name from external enquiry
  // Lead source tracking (UTM, Meta, WhatsApp)
  source                  LeadSource?    // instagram_ads | facebook_ads | website | whatsapp_direct | referral | manual_entry
  medium                  String?        // e.g. whatsapp, cpc
  campaign                String?
  utm_source              String?
  utm_medium              String?
  utm_campaign            String?
  fbclid                  String?        // Meta click ID when present in URL
  submittedAt             DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  // Parent feedback flow
  feedbackStatus          FeedbackStatus @default(NOT_SENT)
  counselingCompletedAt   DateTime?
  feedbackSentAt          DateTime?
  feedbackSubmittedAt    DateTime?
  feedbackToken           String?        @unique

  // Relations
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  course            Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignedCounselor CounselorProfile?   @relation(fields: [assignedCounselorId], references: [id], onDelete: SetNull)
  sessions          CounselingSession[]
  responses         Response[]
  todos             Todo[]
  callLogs          CallLog[]
  leadCalls         LeadCall[]
  parentFeedback    ParentFeedback?

  @@index([assignedCounselorId])
  @@index([autoAssigned])
  @@index([classification])
  @@index([priority])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@index([parentEmail])
  @@index([parentMobile])
  @@index([studentName])  // Performance: for search queries
  @@index([parentName])   // Performance: for search queries
  @@index([institutionId])
  @@index([courseId])
  @@index([assignedCounselorId, status])
  @@index([classification, priority])
  @@index([autoAssigned, assignedCounselorId])
  @@index([source])
  @@map("leads")
}

enum Gender {
  Male
  Female
  Other
}

enum CounselingMode {
  Online
  Offline
}

enum Classification {
  NEW
  COUNSELING_IN_PROGRESS
  PRIORITY
  ADMISSION_CONFIRMED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  ENROLLED
  REJECTED
  ON_HOLD
  CALL_NOT_CONNECTED
}

enum LeadSource {
  instagram_ads
  facebook_ads
  website
  whatsapp_direct
  referral
  manual_entry
}

enum FeedbackStatus {
  NOT_SENT
  SENT
  SUBMITTED
}

// Counseling Session Model
model CounselingSession {
  id                 String         @id @default(cuid())
  leadId             String
  counselorId        String
  scheduledDate      DateTime       // start_time
  endDate            DateTime?      // end_time; if null, treat as start + 30 min for overlap
  duration           Int?           // duration in minutes
  mode               CounselingMode
  meetingType        String?        // For Online: 'AUDIO' | 'VIDEO'; null for Offline
  status             SessionStatus  @default(SCHEDULED)
  remarks            String?
  followUpRequired   Boolean        @default(false)
  followUpDate       DateTime?
  meetingLink        String?        // Google Meet / video link for this session
  googleEventId      String?        // Google Calendar event id
  completedAt        DateTime?      // Set when status = COMPLETED
  // Retry lifecycle for NOT_CONNECTED handling
  attemptCount       Int            @default(0)
  lastAttemptAt      DateTime?
  maxAttempts        Int            @default(3)
  connectionReason   String?        @db.Text
  missedCallReasonType String?      // COUNSELOR_MISSED | PARENT_MISSED | CUSTOM (when status = NOT_CONNECTED)
  isOverdue          Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([leadId])
  @@index([counselorId])
  @@index([status])
  @@index([status, attemptCount])
  @@map("counseling_sessions")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  NOT_CONNECTED
  NO_SHOW_PARENT
  NO_SHOW_COUNSELOR
  RESCHEDULED
  CANCELLED
}

// Training Content Model (Legacy - kept for backward compatibility)
model TrainingContent {
  id           String      @id @default(cuid())
  title        String
  description  String?
  type         ContentType
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  uploadedById String
  isActive     Boolean     @default(true)
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([isActive])
  @@map("training_content")
}

// Training Module Assignment (Many-to-Many: Module ↔ Counselors)
model TrainingModuleAssignment {
  id          String   @id @default(cuid())
  moduleId    String
  counselorId String
  createdAt   DateTime @default(now())

  module    TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([moduleId, counselorId])
  @@index([counselorId])
  @@index([moduleId])
  @@map("training_module_assignments")
}

// Training Module Model (Phase-1)
model TrainingModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  contentType ContentType? // VIDEO | PDF | DOCUMENT | EXCEL | PPT | LINK
  contentUrl  String?  // Unified content URL (links)
  fileUrl     String?  // Uploaded file URL
  fileSize    Int?     // File size in bytes
  thumbnail   String?  // Optional thumbnail for video
  videoUrl    String?  // Legacy
  documentUrl String?  // Legacy
  linkUrl     String?  // Legacy
  duration    Int?     // Duration in minutes
  tags        String[]
  schoolId    String?
  institutionId String?
  courseId    String?
  isPublished Boolean  @default(false)
  viewsCount  Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  school         School?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  institution    Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  course         Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy      User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  progress       TrainingProgress[]
  assignments    TrainingModuleAssignment[]
  embeddings     TrainingEmbedding[]

  @@index([isPublished])
  @@index([schoolId])
  @@index([institutionId])
  @@index([courseId])
  @@index([createdById])
  @@index([contentType])
  @@map("training_modules")
}

// Chunks + embeddings for RAG (Training Assistant chatbot)
model TrainingEmbedding {
  id               String    @id @default(cuid())
  trainingModuleId String
  chunk            String
  embeddingVector  Float[]
  createdAt        DateTime  @default(now())

  trainingModule TrainingModule @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)

  @@index([trainingModuleId])
  @@map("training_embeddings")
}

// Training Progress Model
model TrainingProgress {
  id         String           @id @default(cuid())
  moduleId   String
  counselorId String
  status     TrainingStatus   @default(NOT_STARTED)
  startedAt  DateTime?
  completedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  module    TrainingModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  counselor CounselorProfile  @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([moduleId, counselorId])
  @@index([counselorId])
  @@index([status])
  @@map("training_progress")
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ContentType {
  VIDEO
  PDF
  DOCUMENT
  EXCEL
  PPT
  LINK
}

// Todo Model
model Todo {
  id          String       @id @default(cuid())
  userId      String
  leadId      String?
  title       String
  description String?
  priority    TodoPriority @default(MEDIUM)
  status      TodoStatus   @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leadId])
  @@index([status])
  @@map("todos")
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Admin dashboard alerts (lead unattended, counselor inactivity, auto-reassignment)
enum AdminAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AdminAlertType {
  LEAD_UNATTENDED
  COUNSELOR_INACTIVITY
  LEAD_REASSIGNMENT
}

model AdminAlert {
  id         String             @id @default(cuid())
  type       AdminAlertType
  severity   AdminAlertSeverity @default(WARNING)
  title      String
  message    String
  meta       Json?
  // Used to avoid spamming duplicate alerts across runs (optional).
  dedupeKey  String?            @unique
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  @@index([type, createdAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("admin_alerts")
}

// Activity Log Model
model ActivityLog {
  id         String     @id @default(cuid())
  userId     String
  action     String
  entityType EntityType
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

enum EntityType {
  LEAD
  COUNSELOR
  INSTITUTION
  COURSE
  SESSION
  TRAINING
  USER
  SCHOOL
  QUESTION
}

// Counselor Presence Model (Activity Tracking)
model CounselorPresence {
  id                String      @id @default(cuid())
  counselorId       String      @unique
  lastLoginAt       DateTime?
  lastActivityAt    DateTime?
  status            PresenceStatus @default(OFFLINE)
  activeMinutesToday Int        @default(0)
  totalActiveMinutes Int        @default(0)
  lastStatusChange  DateTime    @default(now())
  clockInAt         DateTime?
  clockOutAt        DateTime?
  breakStartAt      DateTime?
  breakEndAt        DateTime?
  breakReason       String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  dailyAttendance DailyAttendance[]

  @@index([status])
  @@index([lastActivityAt])
  @@map("counselor_presence")
}

enum PresenceStatus {
  ACTIVE
  AWAY
  OFFLINE
  ON_BREAK
  IN_MEETING
}

// Daily Attendance Model
model DailyAttendance {
  id            String   @id @default(cuid())
  counselorId   String
  presenceId    String
  date          DateTime @db.Date
  loginTime     DateTime?
  logoutTime    DateTime?
  activeMinutes Int      @default(0)
  status        AttendanceStatus @default(ABSENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  counselor CounselorPresence @relation(fields: [presenceId], references: [id], onDelete: Cascade)

  @@unique([counselorId, date])
  @@index([date])
  @@index([status])
  @@map("daily_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PARTIAL
}

// Question Model (Q&A System)
model Question {
  id          String   @id @default(cuid())
  text        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  responses Response[]

  @@index([isActive])
  @@index([createdById])
  @@map("questions")
}

// Response Model (Counselor responses to questions)
model Response {
  id          String   @id @default(cuid())
  questionId  String
  counselorId String
  sessionId   String?  // Optional: link to counseling session
  leadId     String?   // Optional: link to lead/student
  answer      String
  context     Json?    // Additional context data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  counselor  CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  session    CounselingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lead       Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  scores     Score[]

  @@index([counselorId])
  @@index([questionId])
  @@index([sessionId])
  @@index([leadId])
  @@map("responses")
}

// Score Model (Scoring system for responses)
model Score {
  id         String   @id @default(cuid())
  responseId String
  points     Int      @default(0)
  category   String?  // e.g., "alignment", "quality", "engagement"
  notes      String?
  createdById String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  response  Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([responseId])
  @@index([createdById])
  @@map("scores")
}

// App Settings - Admin-configurable privileges & form fields
model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json     // JSON value for the setting
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// System-wide settings (single-row table) for lead assignment and other platform-wide flags.
model SystemSettings {
  id                  String             @id @default(cuid())
  leadAssignmentMode  LeadAssignmentMode @default(language)
  // Ordered counselor list is defined by CounselorProfile.createdAt ASC.
  // Store last assigned index so round robin continues across restarts.
  lastRoundRobinIndex Int                @default(-1)
  updatedAt           DateTime           @updatedAt

  @@map("system_settings")
}

// Call dispositions (master data for lead call outcomes)
model CallDisposition {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  leadCalls LeadCall[]

  @@map("call_dispositions")
}

// Lead calls - logged from counselor panel (Call button in lead detail)
model LeadCall {
  id              String    @id @default(cuid())
  leadId          String
  counselorId     String
  callStartTime   DateTime
  callEndTime     DateTime
  dispositionId   String
  notes           String    @db.Text
  createdAt       DateTime  @default(now())

  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counselor   CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  disposition CallDisposition  @relation(fields: [dispositionId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([counselorId])
  @@index([dispositionId])
  @@map("lead_calls")
}

// Voice Call Lead Update - call log entry
model CallLog {
  id                   String    @id @default(cuid())
  leadId               String
  counselorId          String
  callTimestamp        DateTime  @default(now())
  callSummary          String
  leadTemperature      String?
  conversionProbability Int?
  formData             Json?     // Full wizard form data for audit
  createdAt            DateTime  @default(now())

  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counselor CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([counselorId])
  @@index([callTimestamp(sort: Desc)])
  @@map("call_logs")
}

// Master options for Voice Call wizard dropdowns (dynamic, no hardcoding)
model MasterOption {
  id        String   @id @default(cuid())
  category  String   // e.g. passing_year, entrance_exam, loan_required, admission_timeline
  value     String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([category, value])
  @@index([category])
  @@map("master_options")
}

// Historical Admissions & Publicity – uploaded files per institution
model HistoricalFile {
  id            String    @id @default(cuid())
  institutionId String
  fileName      String
  fileType      String    // xlsx, xls, pdf, docx, jpg, jpeg, png
  fileUrl       String
  fileSize      Int?      // bytes
  academicYear  String?
  category      String    // Marketing, Publicity, Both
  description   String?
  parsedData    Json?     // Excel rows as JSON
  extractedText String?   @db.Text // Word/PDF extracted text
  status        HistoricalFileStatus @default(PENDING)
  uploadedById  String
  uploadedAt    DateTime  @default(now())
  verifiedById  String?
  verifiedAt    DateTime?

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  uploadedBy  User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([status])
  @@index([uploadedAt])
  @@map("historical_files")
}

enum HistoricalFileStatus {
  PENDING
  VERIFIED
  LOCKED
}

// Historical Admissions entries (Admissions / Marketing / Publicity) with status and documents
enum HistoricalAdmissionCategory {
  Admissions
  Marketing
  Publicity
}

enum HistoricalAdmissionStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  LOCKED
}

model HistoricalAdmission {
  id            String                      @id @default(cuid())
  institutionId String
  courseId      String?
  academicYear  String
  category      HistoricalAdmissionCategory
  status        HistoricalAdmissionStatus   @default(DRAFT)
  title         String?
  description   String?                     @db.Text
  applicationData Json?                      // Admissions: seats, cutoffs, etc.
  marketingData   Json?                      // Marketing/Publicity: campaign, channels, etc.
  isPlaceholder   Boolean                   @default(false)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  institution Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course?                    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  images      HistoricalAdmissionImage[]

  @@index([institutionId])
  @@index([courseId])
  @@index([category])
  @@index([status])
  @@index([academicYear])
  @@map("historical_admissions")
}

model HistoricalAdmissionImage {
  id                   String   @id @default(cuid())
  historicalAdmissionId String
  fileName             String
  fileUrl              String
  fileType             String
  fileSize             Int?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  historicalAdmission HistoricalAdmission @relation(fields: [historicalAdmissionId], references: [id], onDelete: Cascade)

  @@index([historicalAdmissionId])
  @@map("historical_admission_images")
}

// Historical Admissions & Marketing Intelligence – structured multi-year data
model HistoricalMarketingRecord {
  id                    String   @id @default(cuid())
  institutionId         String
  academicYear          String   // e.g. "2023-24", "2022-23"
  courseName            String
  totalInquiries        Int      @default(0)
  totalApplications     Int      @default(0)
  confirmedAdmissions   Int      @default(0)
  maleCount             Int      @default(0)
  femaleCount           Int      @default(0)
  zipCode               String?
  marketingChannel      String?
  marketingSpend        Float?
  leadsGenerated        Int?
  admissionsFromCampaign Int?
  status                HistoricalMarketingStatus @default(DRAFT)
  sourceType            String?   // EXCEL, PHOTO_OCR
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([academicYear])
  @@index([courseName])
  @@index([zipCode])
  @@index([status])
  @@map("historical_marketing_records")
}

enum HistoricalMarketingStatus {
  DRAFT
  VERIFIED
  LOCKED
}

// Parent feedback after counseling (one per lead)
model ParentFeedback {
  id                   String   @id @default(cuid())
  leadId               String   @unique
  studentName          String
  parentName           String
  email                String
  phone                String
  counselorId          String
  institutionId       String
  experienceRating     Int      // 1-5
  explanationRating    Int      // 1-5
  helpfulnessRating    Int      // 1-5
  questionsAnswered    Boolean
  professionalismRating Int     // 1-5
  interestLevel        String  // Very Interested, Interested, Not Sure, Not Interested
  admissionDecision    String  // Ready to take admission, Need more time, Exploring other institutions, Not interested
  concern              String? // Fees, Location, etc. Only set when interestLevel = Not Interested
  likedFeedback        String? @db.Text
  improvementFeedback  String? @db.Text
  recommend            Boolean
  createdAt            DateTime @default(now())

  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counselor    CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  institution  Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([counselorId])
  @@index([institutionId])
  @@index([createdAt])
  @@map("parent_feedback")
}

// Historical Data & Verification – admin upload → validate → pending → verify → counselor sees only verified
enum HistoricalUploadStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum HistoricalDataType {
  admissions
  leads
  fees
  feedback
}

model HistoricalUpload {
  id               String                  @id @default(cuid())
  institutionId    String
  academicYear     String
  dataType         HistoricalDataType
  description      String?                 @db.Text
  fileUrl          String                  @db.Text
  fileName         String?
  fileSize         Int?
  status           HistoricalUploadStatus @default(PENDING)
  uploadedById     String
  uploadedAt       DateTime                @default(now())
  verifiedById     String?
  verifiedAt       DateTime?
  rejectionReason  String?                 @db.Text

  institution  Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  uploadedBy   User              @relation("HistoricalUploadsUploaded", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy   User?             @relation("HistoricalUploadsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)
  records      HistoricalRecord[]

  @@index([institutionId])
  @@index([status])
  @@index([academicYear])
  @@index([uploadedAt])
  @@map("historical_uploads")
}

model HistoricalRecord {
  id         String   @id @default(cuid())
  uploadId   String
  recordData Json     // Flexible JSONB for parsed row data
  createdAt  DateTime @default(now())

  upload HistoricalUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("historical_records")
}

// ========== PRAVIDYA Multi-Tenant Academy System ==========
model Academy {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  domain        String?
  logoUrl       String?
  description   String?  @db.Text
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  academyUsers AcademyUser[]
  academyLeads AcademyLead[]

  @@index([slug])
  @@index([domain])
  @@map("academies")
}

model AcademyUser {
  id                 String    @id @default(cuid())
  academyId          String
  academy            Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  role               AcademyRole
  fullName           String?   // Display name (e.g. "Rakesh Kumar" for Counselor1)
  email              String
  passwordHash       String
  passwordLastChanged DateTime @default(now())
  otpCode            String?
  otpExpiry          DateTime?
  isVerified         Boolean   @default(false)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([academyId, email])
  @@index([academyId])
  @@index([email])
  @@map("academy_users")
}

model AcademyLead {
  id         String   @id @default(cuid())
  academyId  String
  academy    Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentName String
  parentName  String
  phone       String
  email      String
  course     String
  source     String   @default("DIRECT")
  createdAt   DateTime @default(now())

  @@index([academyId])
  @@index([createdAt(sort: Desc)])
  @@map("academy_leads")
}

enum AcademyRole {
  ADMIN
  COUNSELOR
  MANAGEMENT
}

// ========== Central Intelligence (RAG Engine) ==========

model KnowledgeSource {
  id             String   @id @default(cuid())
  organizationId String
  fileName       String
  filePath       String
  fileType       String
  uploadedBy     String
  contentHash    String?  // SHA256 of extracted text — used to reject duplicate content (same file or same content different format)
  createdAt      DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([organizationId])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId, contentHash])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  sourceId       String
  organizationId String
  content        String   @db.Text
  embedding      Unsupported("vector(1536)")
  metadata       Json
  createdAt      DateTime @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sourceId])
  @@map("knowledge_chunks")
}

model QueryCache {
  id             String   @id @default(cuid())
  organizationId String
  query          String   @db.Text
  response       String   @db.Text
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("intelligence_query_cache")
}

// ========== SaaS License-Based Onboarding (Jeetofy) ==========

model SaasAcademy {
  id            String      @id @default(cuid())
  academyId     String      @unique
  schoolName    String
  logoUrl       String?
  address       String?
  licenseExpiry DateTime

  users         SaasUser[]

  @@index([academyId])
  @@map("saas_academies")
}

enum SaasRole {
  ADMIN
  TEACHER
  STAFF
}

model SaasUser {
  id        String   @id @default(cuid())
  academyId String
  email     String
  password  String
  role      SaasRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy   SaasAcademy @relation(fields: [academyId], references: [academyId], onDelete: Cascade)

  @@unique([academyId, email])
  @@index([academyId])
  @@map("saas_users")
}


