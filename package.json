{
  "name": "admissions-backend",
  "version": "1.0.0",
  "description": "Production-ready MERN admissions platform backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "chmod +x node_modules/.bin/prisma || true && npx prisma generate",
    "postinstall": "npm run build",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedPrisma.js",
    "seed:pravidya": "node scripts/seedPravidyaAcademy.js",
    "seed:settings": "node scripts/seedAppSettings.js",
    "seed:dispositions": "node scripts/seedCallDispositions.js",
    "seed:superadmin": "node scripts/seedSuperAdmin.js",
    "seed:old": "node scripts/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "migrate:historical": "node scripts/runHistoricalMarketingMigration.js",
    "delete:historical": "node scripts/deleteHistoricalData.js"
  },
  "keywords": [
    "admissions",
    "mern",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.0.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "svg-captcha": "^1.4.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0"
  },
  "directories": {
    "doc": "docs"
  }
}